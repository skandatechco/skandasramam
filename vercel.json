{
  "installCommand": "pnpm config set require-scripts-approval false && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:client && pnpm run build:api",
  "outputDirectory": "dist/spa",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store" },
        { "key": "Vary", "value": "Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
