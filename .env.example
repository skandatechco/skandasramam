# Copy to .env.local (git-ignored via *.local) for local development, and set the
# same names in Vercel > Project Settings > Environment Variables. Never commit values.

# --- Server-only (never prefix with VITE_; never exposed to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Existing Prokerala credentials (already used by server/integrations/prokerala.ts)
# PROKERALA_API_TOKEN=
# PROKERALA_CLIENT_ID=
# PROKERALA_CLIENT_SECRET=

# --- Administration (Phase D) ---
# Server: the admin API acts AS the signed-in admin (anon key + their JWT, so RLS applies).
# It does NOT use the service-role key. SUPABASE_ANON_KEY falls back to VITE_SUPABASE_ANON_KEY.
# SUPABASE_ANON_KEY=
# Browser (build-time, public by design: project URL + ANON key only, never the service-role key):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Admin accounts are created in Supabase Auth by you, then added to public.admin_users.

# --- Payments: production keeps payment references OFF until BOTH are set ---
# Set at launch, only after the real temple QR is at public/images/temple-upi-qr.png
# PAYMENTS_LIVE=true                # server: accept payment references in production
# VITE_PAYMENT_QR_CONFIGURED=true   # client: show the real QR (build-time variable)
# VITE_UPI_ID=                      # optional; supplied by the temple, never invented
